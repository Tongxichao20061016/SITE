<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D 渐变立方体</title>
    <style>
        /* 全局样式：清除默认边距，实现页面居中 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* 容器：设置3D透视效果，让立方体有立体视觉 */
        .cube-container {
            /* 视口全屏居中 */
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            /* 关键：开启3D空间 + 透视距离（值越小立体效果越强） */
            perspective: 1000px;
            background-color: #1a1a1a;
        }

        /* 立方体父元素：承载6个面，设置3D变换 */
        .cube {
            width: 200px;
            height: 200px;
            /* 关键：保留子元素的3D变换效果 */
            transform-style: preserve-3d;
            /* 可选：添加旋转动画，让立方体自动旋转（更直观看到3D效果） */
            animation: rotateCube 8s linear infinite;
        }

        /* 立方体6个面通用样式 */
        .cube-face {
            /* 绝对定位，让所有面重叠在立方体中心 */
            position: absolute;
            width: 200px;
            height: 200px;
            /* 半透明效果，能看到内部结构 */
            opacity: 0.9;
            /* 让面的边缘更柔和 */
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* 1. 正面：向前平移（Z轴正方向） */
        .front {
            background: linear-gradient(45deg, #ff6b6b, #feca57);
            transform: translateZ(100px);
        }

        /* 2. 背面：向后平移（Z轴负方向） */
        .back {
            background: linear-gradient(45deg, #48dbfb, #0abde3);
            transform: translateZ(-100px);
        }

        /* 3. 左侧面：向左平移 + 斜切变换 + 旋转 */
        .left {
            background: linear-gradient(45deg, #ff9ff3, #f368e0);
            transform: translateX(-100px) skewY(45deg) rotateY(90deg);
        }

        /* 4. 右侧面：向右平移 + 斜切变换 + 旋转 */
        .right {
            background: linear-gradient(45deg, #1dd1a1, #10ac84);
            transform: translateX(100px) skewY(-45deg) rotateY(90deg);
        }

        /* 5. 顶部面：向上平移 + 斜切变换 + 旋转 */
        .top {
            background: linear-gradient(45deg, #ff9f43, #ff6b35);
            transform: translateY(-100px) skewX(45deg) rotateX(90deg);
        }

        /* 6. 底部面：向下平移 + 斜切变换 + 旋转 */
        .bottom {
            background: linear-gradient(45deg, #5f27cd, #341f97);
            transform: translateY(100px) skewX(-45deg) rotateX(90deg);
        }

        /* 立方体旋转动画：让3D效果更明显 */
        @keyframes rotateCube {
            0% {
                transform: rotateX(0deg) rotateY(0deg);
            }
            100% {
                transform: rotateX(360deg) rotateY(360deg);
            }
        }
    </style>
</head>
<body>
    <!-- 3D透视容器 -->
    <div class="cube-container">
        <!-- 立方体主体 -->
        <div class="cube">
            <!-- 6个面：分别对应立方体的前、后、左、右、上、下 -->
            <div class="cube-face front"></div>
            <div class="cube-face back"></div>
            <div class="cube-face left"></div>
            <div class="cube-face right"></div>
            <div class="cube-face top"></div>
            <div class="cube-face bottom"></div>
        </div>
    </div>
</body>
</html>
